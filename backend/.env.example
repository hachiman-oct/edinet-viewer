# Option A: Direct file path (relative to backend/)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Option B: 1Password CLI (`op run --env-file=backend/.env -- ...`)
# GOOGLE_CREDENTIALS_JSON="op://Private/GCP-ServiceAccount/credentials.json"
# EDINET_API_KEY="op://Private/EDINET/api_key"

# EDINET API Key (optional, can also be passed from frontend)
EDINET_API_KEY=
